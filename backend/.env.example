# dev | prod | test
ENV=dev

# Local MongoDB for dev; the Atlas SRV URI for prod:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=stumble

# Comma-separated. In dev, *.trycloudflare.com is also allowed automatically.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# real (default): every key below is required and the server refuses to start without one.
# fake: offline stand-ins with canned replies. Only ever set this on purpose.
PROVIDERS=real

# LLM via OpenRouter (OpenAI-compatible).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Speech-to-text via Groq
GROQ_API_KEY=

# Text-to-speech via ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
